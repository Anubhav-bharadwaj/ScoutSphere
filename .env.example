ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=scoutsphere
POSTGRES_PASSWORD=changeme
POSTGRES_DB=scoutsphere
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://scoutsphere:changeme@localhost:5432/scoutsphere

# --- Redis / Celery (infra provisioned in Batch 1; Celery app wired in Batch 3) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- ChromaDB ---
CHROMA_HOST=localhost
CHROMA_PORT=8001

# --- JWT / Auth ---
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OpenAI (used from Phase 2 onward for the Evaluator agent; harmless if unset in Phase 1) ---
OPENAI_API_KEY=

# --- Resume storage (Batch 4) ---
RESUME_STORAGE_DIR=./storage/resumes
RESUME_ENCRYPTION_KEY=replace-with-a-32-byte-urlsafe-base64-fernet-key

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:3000"]